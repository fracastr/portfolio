---
import { getAlternateLocalePath } from "../lib/locale";
import type { SectionLabels } from "../content/types";

interface Props {
  sections: SectionLabels;
  currentLocale: "en" | "es";
}

const { sections, currentLocale } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const alternatePath = getAlternateLocalePath(Astro.url.pathname);
const alternateLabel = currentLocale === "en" ? "ES" : "EN";
const aboutLabel = currentLocale === "en" ? "About" : "Sobre";
const menuLabel = currentLocale === "en" ? "Index" : "Índice";
const lightLabel = currentLocale === "en" ? "Light" : "Claro";
const darkLabel = currentLocale === "en" ? "Dark" : "Oscuro";
const themeLabel = currentLocale === "en" ? "Color mode" : "Modo de color";
const educationNav = currentLocale === "en" ? "Education" : "Educación";
const links = [
  ["#about", aboutLabel],
  ["#projects", sections.projects],
  ["#experience", sections.experience],
  ["#skills", sections.skills],
  ["#education", educationNav],
  ["#contact", sections.contact],
] as const;
---

<header class="bar">
  <div class="shell bar-inner">
    <a class="brand" href={currentLocale === "en" ? base : `${base}es/`}>FC</a>
    <button type="button" class="menu" aria-expanded="false" aria-controls="site-nav">{menuLabel}</button>
    <nav id="site-nav">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
      <span class="controls">
        <button type="button" class="theme" aria-pressed="false" aria-label={themeLabel}>
          <span class="when-light">{lightLabel}</span>
          <span class="when-dark">{darkLabel}</span>
        </button>
        <a class="locale" href={alternatePath}>{alternateLabel}</a>
      </span>
    </nav>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bar);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--ink);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 3rem;
  }

  .brand {
    text-decoration: none;
    font-family: var(--cond);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .menu { display: none; }

  nav {
    display: flex;
    gap: 1.15rem;
    margin-left: auto;
    align-items: center;
  }

  nav a { white-space: nowrap; }

  .controls {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 0.35rem;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.92rem;
    transition: color 160ms ease;
  }

  nav a[aria-current="true"] { color: var(--amber); }

  .locale,
  .theme {
    border: 1px solid var(--ink);
    padding: 0.1rem 0.4rem;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    transition: transform 140ms var(--ease-out), color 160ms ease;
  }

  .locale:active,
  .theme:active { transform: scale(0.97); }

  html:not([data-theme="dark"]) .when-dark,
  html[data-theme="dark"] .when-light { display: none; }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover { color: var(--ink); }
  }

  @media (max-width: 800px) {
    .bar-inner { position: relative; flex-wrap: wrap; }
    .menu {
      display: inline-flex;
      margin-left: auto;
      border: 1px solid var(--ink);
      background: transparent;
      font: inherit;
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      transition: transform 140ms var(--ease-out);
    }
    .menu:active { transform: scale(0.97); }
    .controls { margin-left: 0; }
    nav {
      position: absolute;
      top: 100%;
      right: 0;
      margin: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      width: min(16rem, 100%);
      padding: 0.8rem 1rem;
      background: var(--menu);
      backdrop-filter: blur(16px);
      border: 1px solid var(--ink);
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      visibility: hidden;
      transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
    }
    .bar[data-open] nav {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    nav, .locale, .theme, .menu { transition: none; transform: none; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".bar");
  const menu = document.querySelector<HTMLButtonElement>(".menu");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  const toggleLink = document.querySelector<HTMLAnchorElement>(".locale");
  const themeButton = document.querySelector<HTMLButtonElement>(".theme");

  const paintTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    themeButton?.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
  };

  paintTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    paintTheme(next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* preference stays for this view */
    }
  });

  menu?.addEventListener("click", () => {
    const open = bar?.dataset.open !== "true";
    if (bar) bar.dataset.open = open ? "true" : "";
    menu.setAttribute("aria-expanded", open ? "true" : "false");
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (bar) bar.dataset.open = "";
      menu?.setAttribute("aria-expanded", "false");
    });
  });

  toggleLink?.addEventListener("click", () => {
    if (location.hash) toggleLink.href = toggleLink.href.split("#")[0] + location.hash;
  });

  const sections = [...document.querySelectorAll<HTMLElement>("section[id]")];
  const links = [...document.querySelectorAll<HTMLAnchorElement>("#site-nav a[href^='#']")];
  const mark = () => {
    const line = scrollY + 96;
    let current = "";
    for (const section of sections) {
      if (section.offsetTop <= line) current = section.id;
    }
    for (const link of links) {
      if (link.getAttribute("href") === `#${current}`) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };
  mark();
  addEventListener("scroll", mark, { passive: true });
</script>
