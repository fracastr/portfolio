---
import { techMarks, type TechMarkId } from "../lib/tech-marks";

interface Props {
  label: string;
}

const { label } = Astro.props;

const rules: [RegExp, TechMarkId][] = [
  [/laravel/i, "laravel"],
  [/php/i, "php"],
  [/typescript/i, "typescript"],
  [/javascript/i, "javascript"],
  [/react/i, "react"],
  [/vue/i, "vue"],
  [/angular/i, "angular"],
  [/node/i, "node"],
  [/python/i, "python"],
  [/\.net|c#/i, "dotnet"],
  [/sql server/i, "sqlserver"],
  [/postgres/i, "postgresql"],
  [/couchbase/i, "couchbase"],
  [/jenkins/i, "jenkins"],
  [/\baws\b/i, "aws"],
  [/\bgcp\b/i, "gcp"],
  [/docker/i, "docker"],
  [/\bgit\b/i, "git"],
  [/linux/i, "linux"],
  [/bash/i, "bash"],
];

const icons = rules.filter(([pattern]) => pattern.test(label)).map(([, id]) => id);
---

<span class="tech">
  {
    icons.map((id) => {
      const mark = techMarks[id];
      return (
        <svg class="mark" viewBox={mark.viewBox} aria-hidden="true">
          {mark.paths.map((d) => <path d={d} />)}
        </svg>
      );
    })
  }
  <span>{label}</span>
</span>

<style>
  .tech {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mark {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    fill: currentColor;
  }
</style>
