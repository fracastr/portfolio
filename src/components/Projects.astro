---
import type { ProjectEntry } from "../content/types";
import TechLabel from "./TechLabel.astro";

interface Props {
  heading: string;
  projects: ProjectEntry[];
}

const { heading, projects } = Astro.props;
---

<section id="projects" class="shell">
  <h2>{heading}</h2>
  <div class="plates">
    {
      projects.map((project) => (
        <article id={project.id}>
          <header>
            <h3>{project.company}</h3>
            <p>{project.role}</p>
            <p class="when">{project.period}</p>
          </header>
          <div class="body">
            <p>{project.context}</p>
            <ul>
              {project.achievements.map((item) => <li>{item}</li>)}
            </ul>
            <p class="stack">
              {project.stack.map((item) => <TechLabel label={item} />)}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  article {
    display: grid;
    gap: 1.15rem 2.5rem;
    padding: 1.6rem 0 1.75rem;
    border-top: 1px solid var(--ink);
    transition: background 160ms ease;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .body p,
  .body ul { margin: 0; }

  header p {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .when {
    font-family: var(--cond);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  h3 { margin: 0; font-size: 1.35rem; }

  article p { max-width: var(--measure); }

  ul {
    max-width: var(--measure);
    padding-left: 1.15rem;
  }

  li + li { margin-top: 0.35rem; }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    font-family: var(--cond);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (hover: hover) and (pointer: fine) {
    article:hover { background: var(--hover); }
  }

  @media (min-width: 800px) {
    article { grid-template-columns: 17rem 1fr; align-items: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    article { transition: none; }
  }
</style>
