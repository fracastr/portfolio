---
import type { ExperienceEntry } from "../content/types";

interface Props {
  heading: string;
  entries: ExperienceEntry[];
}

const { heading, entries } = Astro.props;
---

<section id="experience" class="shell">
  <h2>{heading}</h2>
  <ol>
    {
      entries.map((entry) => (
        <li>
          <span class="when">{entry.period}</span>
          <span class="detail">
            <strong>{entry.title}</strong>
            <span class="co">{entry.company}</span>
            <span class="where">{entry.location}</span>
          </span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .when {
    font-family: var(--cond);
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  strong { display: block; font-weight: 600; }

  .co, .where {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (min-width: 700px) {
    li { grid-template-columns: 14rem 1fr; align-items: baseline; }
  }
</style>
