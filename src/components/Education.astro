---
import type { EducationBlock } from "../content/types";

interface Props {
  heading: string;
  education: EducationBlock;
}

const { heading, education } = Astro.props;
---

<section id="education" class="shell">
  <h2>{heading}</h2>
  <p class="degree">{education.degree}</p>
  <p class="place">{education.institution}, {education.location}</p>
  <ul>
    {education.certifications.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .degree { margin: 0; font-size: 1.15rem; }
  .place { margin: 0.25rem 0 0.8rem; color: var(--muted); }
  ul { margin: 0.4rem 0 0; padding-left: 1.15rem; max-width: var(--measure); color: var(--muted); }
  li + li { margin-top: 0.35rem; }
</style>
