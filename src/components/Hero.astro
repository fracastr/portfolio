---
interface Props {
  name: string;
  title: string;
  location: string;
  availability: string;
  placeLabel: string;
  statusLabel: string;
}

const { name, title, location, availability, placeLabel, statusLabel } = Astro.props;
---

<section class="plate shell" aria-label={name}>
  <h1>{name}</h1>
  <p class="role">{title}</p>
  <dl>
    <div>
      <dt>{placeLabel}</dt>
      <dd>{location}</dd>
    </div>
    <div>
      <dt>{statusLabel}</dt>
      <dd class="live">{availability}</dd>
    </div>
  </dl>
</section>

<style>
  .plate {
    padding-top: 4.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 6rem);
    line-height: 0.92;
    font-weight: 600;
    max-width: 12ch;
  }

  .role {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
  }

  dt {
    font-family: var(--cond);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0.2rem 0 0;
    font-size: 1rem;
  }

  .live {
    color: var(--amber);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    dl { grid-template-columns: 1fr; }
  }
</style>
