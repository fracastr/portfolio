---
interface Props {
  name: string;
  title: string;
  location: string;
  availability: string;
}

const { name, title, location, availability } = Astro.props;
---

<section class="hero container">
  <h1>{name}</h1>
  <p class="role">{title}</p>
  <p class="meta">{location} · {availability}</p>
</section>

<style>
  .hero {
    padding-top: 3rem;
    animation: fade-up 0.6s ease both;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 0.25rem;
  }

  .role {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      animation: none;
    }
  }
</style>
