---
import type { BuildEntry } from "../content/types";

interface Props {
  heading: string;
  note: string;
  builds: BuildEntry[];
  visitLabel: string;
}

const { heading, note, builds, visitLabel } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const count = String(builds.length).padStart(2, "0");
---

<section id="work" class="shell section" aria-labelledby="work-title">
  <div class="section-head">
    <h2 id="work-title">{heading}</h2>
    <span class="mono">{count} · {note}</span>
  </div>

  <ul class="grid">
    {
      builds.map((build) => (
        <li data-reveal>
          <article class="card">
            <div class="media themed">
              {build.image ? (
                <img
                  src={`${base}images/work/${build.image}`}
                  alt={build.imageAlt}
                  width="1200"
                  height="750"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="equation" role="img" aria-label={build.imageAlt}>
                  <span>Fe in → concentrate out</span>
                  <span>Σ feed = Σ product + Σ tailings</span>
                  <span class="ok">balance ✓ reconciled</span>
                </div>
              )}
            </div>
            <div class="meta mono">
              <span>{build.kind}</span>
              {build.domain && <span>{build.domain}</span>}
            </div>
            <h3>
              {build.url ? (
                <a href={build.url} rel="noopener">
                  {build.name}
                  <span class="arrow" aria-hidden="true">↗</span>
                  <span class="sr-only">({visitLabel})</span>
                </a>
              ) : (
                build.name
              )}
            </h3>
            <p class="serif">{build.description}</p>
            <ul class="tags" aria-label="Stack">
              {build.stack.map((item) => <li class="tag">{item}</li>)}
            </ul>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 3rem 2rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: var(--elev);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .card:hover .media img { transform: scale(1.05); }

  .equation {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.5rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  .equation .ok { color: var(--amber); }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  /* The whole card is the link target; the title carries the name. */
  h3 a::before {
    content: "";
    position: absolute;
    inset: 0;
  }

  h3 .arrow {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 1rem;
    color: var(--muted);
    transition: transform 200ms var(--ease), color 200ms var(--ease);
  }

  .card:hover h3 .arrow {
    transform: translate(3px, -3px);
    color: var(--ember);
  }

  p {
    margin: 0;
    font-size: 1.12rem;
    line-height: 1.5;
    color: var(--body);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .grid > li { transition-delay: calc(var(--d, 0) * 80ms); }
  .grid > li:nth-child(3n + 2) { --d: 1; }
  .grid > li:nth-child(3n + 3) { --d: 2; }
</style>
